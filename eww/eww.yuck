;; ===========================================================================
;; Clock-With-Weather-EWW
;;
;; Windows:
;;   1. main_window     -> Clock + Weather widget (dynamic width x 247 x scale)
;;   2. panel_window    -> System monitor panel (CPU / MEMORY / NET DOWN / NET UP)
;;   3. ctx_menu        -> right-click quick-settings menu (Move / Resize /
;;                         Reset / AM-PM switch / Theme / Units / Panel on-off /
;;                         Side / Panel gap / Weather / Hard reset / About)
;;
;; The Move/Resize rectangle + the GTK control panels (Move/Resize, Panel
;; gap, Weather settings) and the About dialog are GTK3 windows
;; (scripts/move/move_rect.py + move/move_panel.py + move/gap_panel.py +
;; move/weather_panel.py + widgets/about_win.py), not eww windows.
;; ===========================================================================

;; --- Context menu state (see scripts/move/move.py) -------------------------------
;; move_pct = width %, move_pct_h = height % of the Move/Resize rectangle
;; (they differ after a non-proportional width-only / height-only resize).
(defvar move_x 0)
(defvar move_y 0)
(defvar move_w 100)
(defvar move_h 100)
(defvar move_pct 100)
(defvar move_pct_h 100)

;; --- Hover submenu state (see scripts/widgets/submenu.py) ------------------------
;; The whole picker is prebuilt by submenu.py into this variable (a static
;; yuck definition with real values + handlers baked in) and rendered via
;; `literal`: handlers on widgets created inside `(for ...)` loops never fire
;; on eww 0.6.0, so dynamic looping is not an option here.
(defvar sub_yuck "")
;; The picker pane lives inside the ctx_menu window (right of the item rows):
;; sub_top positions it next to the hovered row, sub_show toggles it. Pure
;; variables -> identical behavior on X11 and Wayland, no extra window.
(defvar sub_top 7)
(defvar sub_cols 1)
;; Horizontal flip: when the menu opens near the RIGHT monitor edge, ctx.py
;; opens the window shifted left and sets sub_left=true + sub_right=false,
;; so the picker pane renders on the LEFT side of the parent menu column
;; (the right pane is hidden) and never gets clipped by the screen edge.
;; Both flags are plain globals always written as a pair by ctx.py (no
;; negation expressions - eww 0.6.0 is unreliable at those), and the
;; visibility lives on the INNER box: a hidden eventbox would still be
;; clickable, a hidden box is removed from the layout entirely.
(defvar sub_left false)
(defvar sub_right true)
(defvar sub_show false)


;; --- Clock data ------------------------------------------------------------
(defpoll hour :interval "1s"
  `date +$(../scripts/core/config.py --key hour_format | sed 's/24/%H/; s/12/%I/')`)

(defpoll minutes :interval "1s" `date +:%M`)

(defpoll seconds :interval "1s" `date +%S`)

;; AM/PM indicator (%p), only displayed when hour_format is "12" (see the
;; meridiem-chip / meridiem-label widgets and config.hour_format).
(defpoll meridiem :interval "1s"
  `LC_TIME=en_US.UTF-8 date +%p`)

(defpoll date_year :interval "1m"
  `date +%Y.`)

(defpoll date_day :interval "1m"
  `LC_TIME=en_US.UTF-8 date "+| %B %d. | %A"`)

;; --- System info (HDD / CPU / RAM / SWAP) -----------------------------------
(defpoll system_info :interval "5s"
  `../scripts/core/system.py`)

;; --- Weather ----------------------------------------------------------------
(defpoll weather_info :interval "10m"
  `../scripts/core/weather.py $(../scripts/core/config.py --key api_key) $(../scripts/core/config.py --key city) $(../scripts/core/config.py --key lang) $(../scripts/core/config.py --key units) $(../scripts/core/config.py --key api_url)`)

;; --- System monitor panel (CPU / MEMORY / NET UP / NET DOWN charts) ---------
(defpoll panel :interval "1s"
  `../scripts/widgets/panel.py`)

;; --- Configuration / theme --------------------------------------------------
;; The inotify watcher (scripts/core/watch.py) already reloads the widget on YAML
;; changes; these short intervals are a safety net for external edits.
(defpoll config :interval "5s" `../scripts/core/config.py`)

(defpoll theme :interval "5s" `cat eww.theme.json`)

;; ===========================================================================
;; Image path helpers
;; ===========================================================================

(defwidget widget_clock_weather [main_w main_h main_scale_perc_x main_scale_perc_y main_translate_x main_translate_y screen]
  (eventbox :timeout "10s" :onrightclick "../scripts/widgets/ctx.py --widget clock --monitor ${screen}"
    ;; Independent axis scales: width follows main_scale_perc_x, height
    ;; follows main_scale_perc_y (equal unless the Move/Resize dialog was
    ;; used to resize a single axis). The canvas window is max(natural,
    ;; visible) per axis; below 100% the :translate values (pre-divided by
    ;; the axis scale: this eww build applies scale BEFORE translate, so
    ;; scale × translate must equal the desired device-pixel offset) shift
    ;; the drawing so it lands exactly on the
    ;; visible rectangle while the oversized transparent canvas stays fully
    ;; on-screen (an overflowing managed X11 window would be relocated by
    ;; the WM). Above 100% both translates are 0 and the enlarged canvas
    ;; prevents clipping.
    (transform :scale-x "${main_scale_perc_x}%" :scale-y "${main_scale_perc_y}%"
               :translate-x {main_translate_x}
               :translate-y {main_translate_y}
      (box :class "main-container" :orientation "h" :space-evenly false

    ;; ------------------------------------------------------------------
    ;; ABSOLUTE layout (main_w x main_h; main_w = dynamic natural width ending
    ;; at the city name, main_h = natural height = the visible bg). Baseline
    ;; coordinates converted to the label top: CSS margin-top =
    ;; baseline_y - 0.73*font_size (cap height); images anchored to the top-left
    ;; corner (pos - size/2).
    ;; ------------------------------------------------------------------
    (overlay :class "widget-overlay"
      (box :class "section-sizer" :width {main_w} :height {main_h})

      ;; Background filling the window canvas exactly, so the widget (bg),
      ;; the window and the Move/Resize rectangle are the same size.
      (box :class "widget-bg" :halign "start" :valign "start" :width {main_w} :height {main_h})

      ;; Date / year --- text(20,45) / text(70,45), font 20
      (label :class "year-label" :text date_year
             :halign "start" :valign "start")
      (label :class "date-label" :text date_day
             :halign "start" :valign "start")

      ;; Hour / minutes / seconds --- text(10/170/366,122)
      (label :class "hour-label" :text hour
             :halign "start" :valign "start")
      (label :class "minutes-label" :text minutes
             :halign "start" :valign "start")
      (label :class "seconds-label" :text {": " + seconds}
             :halign "start" :valign "start")

      ;; AM/PM indicator --- chip + text at the bottom of the hour digits
      ;; (baseline y=122, font 28). Only rendered in 12-hour mode.
      (box :class "meridiem-chip"
           :halign "start" :valign "start"
           :visible {config.hour_format == "12"})
      (label :class "meridiem-label" :text meridiem
             :visible {config.hour_format == "12"}
             :halign "start" :valign "start")

      ;; System info table (HDD/CPU | values | RAM/SWAP | values)
      ;; Column X positions: col1=16, col2=65, col3=219, col4=276 -> gap 15px
      ;; between columns and between the last column and the divider (x=414),
      ;; computed from the current value widths (HDD "339.8 GB / 455.4 GB" 139px,
      ;; SWAP "0% (size: 62.6 GB)" 123px). Rows at y=178 / 192 (14px pitch, the
      ;; same as the weather description/MIN-MAX-feels rows).
      (label :class "sys-label hdd-label" :text "HDD"
             :halign "start" :valign "start")
      (label :class "sys-value hdd-value" :text {system_info.hdd}
             :halign "start" :valign "start")
      (label :class "sys-label ram-label" :text "RAM"
             :halign "start" :valign "start")
      (label :class "sys-value ram-value" :text {system_info.ram}
             :halign "start" :valign "start")
      (label :class "sys-label cpu-label" :text "CPU"
             :halign "start" :valign "start")
      (label :class "sys-value cpu-value" :text {system_info.cpu}
             :halign "start" :valign "start")
      (label :class "sys-label swap-label" :text "SWAP"
             :halign "start" :valign "start")
      (label :class "sys-value swap-value" :text {system_info.swap}
             :halign "start" :valign "start")

      ;; Vertical divider line --- image centered (415,110), 1x205
      (image :class "divider"
             :path { "../generated/icons/" + theme.theme + "/elements/line.png" }
             :image-width 2 :image-height 186
             :halign "start" :valign "start")

      ;; Weather icon --- image centered (470,57), 64x64
      (image :class "weather-icon"
             :path { "../generated/icons/" + theme.theme + "/weather/" + theme.icon_set + "/" + weather_info.icon_path + ".png" }
             :image-width 64 :image-height 64
             :halign "start" :valign "start")

      ;; City --- icon centered (440,112) 20x20; text(465,112) font 30
      (image :class "city-icon"
             :path { "../generated/icons/" + theme.theme + "/elements/map-marker-gray.png" }
             :image-width 20 :image-height 20
             :halign "start" :valign "start")
      (label :class "city-label" :text {config.city}
             :halign "start" :valign "start")

      ;; Temperature --- thermometer icon beside celsius, same row as CPU/SWAP
      (image :class "temp-icon"
             :path { "../generated/icons/" + theme.theme + "/elements/temperature-gray.png" }
             :image-width 32 :image-height 32
             :halign "start" :valign "start")
      (label :class "temp-label" :text {weather_info.temp_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start")

      ;; Description --- icon centered (435,175) 10x10; text(445,180) font 15
      (image :class "details-icon"
             :path { "../generated/icons/" + theme.theme + "/elements/arrow-right.png" }
             :image-width 10 :image-height 10
             :halign "start" :valign "start")
      (label :class "details-label" :text {weather_info.weather[0].description}
             :halign "start" :valign "start")

      ;; MIN --- icon centered (435,195) 10x10; text(445,200) font 15,
      ;;         shares the description column (icon 430 / text 444)
      (image :class "stat-icon stat-min-icon"
             :path { "../generated/icons/" + theme.theme + "/elements/arrow-down.png" }
             :image-width 10 :image-height 10
             :halign "start" :valign "start")
      (label :class "stat-label stat-min-label" :text {weather_info.temp_min_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start")

      ;; MAX --- icon centered (485,195) 10x10; text(499,200) font 15
      (image :class "stat-icon stat-max-icon"
             :path { "../generated/icons/" + theme.theme + "/elements/arrow-up.png" }
             :image-width 10 :image-height 10
             :halign "start" :valign "start")
      (label :class "stat-label stat-max-label" :text {weather_info.temp_max_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start")

      ;; FEELS LIKE --- icon centered (538,195) 4x10; text(544,200) font 15
      (image :class "stat-icon stat-feels-icon"
             :path { "../generated/icons/" + theme.theme + "/elements/white-man.png" }
             :image-width 4 :image-height 10
             :halign "start" :valign "start")
      (label :class "stat-label stat-feels-label" :text {weather_info.feels_like_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start"))))))


;; ===========================================================================
;; System monitor panel
;; ===========================================================================

(defwidget widget_panel [ph panel_scale_perc_x panel_scale_perc_y panel_translate_x panel_translate_y screen]
  (eventbox :timeout "10s" :onrightclick "../scripts/widgets/ctx.py --widget panel --monitor ${screen}"
    (transform :scale-x "${panel_scale_perc_x}%" :scale-y "${panel_scale_perc_y}%"
               :translate-x {panel_translate_x}
               :translate-y {panel_translate_y}
      (box :class "panel-container" :orientation "v" :space-evenly true

        (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
          (label :class "panel-title panel-title-cpu" :text "CPU" :halign "start")
          (label :class "panel-status" :text {panel.cpu_txt} :halign "start")
          (image :class "panel-chart" :path {panel.files[ph].cpu} :halign "start"))

        (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
          (label :class "panel-title panel-title-memory" :text "MEMORY" :halign "start")
          (label :class "panel-status" :text {panel.mem_txt} :halign "start")
          (image :class "panel-chart" :path {panel.files[ph].mem} :halign "start"))

        (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
          (label :class "panel-title panel-title-down" :text "NET DOWN" :halign "start")
          (label :class "panel-status" :text {panel.down_txt} :halign "start")
          (image :class "panel-chart" :path {panel.files[ph].down} :halign "start"))

        (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
          (label :class "panel-title panel-title-up" :text "NET UP" :halign "start")
          (label :class "panel-status" :text {panel.up_txt} :halign "start")
          (image :class "panel-chart" :path {panel.files[ph].up} :halign "start"))))))

;; ===========================================================================
;; Context menu (quick settings: Move / Resize / Reset / toggles / About)
;; ===========================================================================

;; The four (hover) selectable/action columns are grouped by domain and
;; context-sensitive: the menu shows only the rows that belong to the widget
;; it was opened on. Layout (16 markup rows, 12 visible per widget):
;;
;;   0 Move            4 AM/PM ▸  ONLY-clock    10 Panel ▸      ONLY-panel
;;   1 Resize          5 Theme ▸  BOTH          11 Side ▸       ONLY-panel
;;   2 Reset           6 sep      ONLY-clock    12 Panel gap    ONLY-panel
;;   3 sep             7 Units ▸  ONLY-clock    13 sep
;;                    8 Weather  ONLY-clock    14 Hard reset
;;                    9 sep      ONLY-panel    15 About
;;
;; The context-filtered rows are wrapped in plain :visible boxes so the
;; hidden rows COLLAPSE from the column (a bare :visible eventbox keeps its
;; layout slot) - the ROW indices for the picker-pane math are therefore the
;; COLLAPSED (visible) positions: in the clock column Theme is row 5, in the
;; panel column row 4 (AM/PM hidden) with Panel=6 / Side=7. These are
;; duplicated in CONTEXT_ROWS in scripts/widgets/submenu.py, which MUST stay
;; in sync. The hover-only rows (AM/PM, Theme, Units, Panel, Side) open
;; scripts/widgets/submenu.py --item <key> --widget ${widget} when the
;; pointer enters; submenu.py scopes its row-offset math to the open widget's
;; menu. Every non-submenu row (Move / Resize / Reset / Weather / Panel gap /
;; Hard reset / About) runs scripts/widgets/submenu_hide.py on hover so a
;; still-open picker pane does NOT stick (these rows are eventboxes -- eww
;; buttons never fire :onhover). The submenu lives exactly as long as this
;; menu — every dismissal path (option click, outside click, ESC, another
;; right-click) goes through close_popup.py. Move / Resize / Reset keep their
;; click behavior. Slower actions are nohup-backgrounded to keep the click
;; instant, exactly like Move / Resize.
(defwidget widget_ctx_menu [widget monitor]
  (box :orientation "h" :space-evenly false
    ;; LEFT picker pane — only visible in the flipped layout (sub_left=true,
    ;; set at menu-open time by ctx.py when the menu sits near the RIGHT
    ;; monitor edge): the pane then renders on the LEFT side of the menu
    ;; column, so no column is clipped by the screen edge. The pane strip is
    ;; a FIXED 375px (the widest picker) wrapped in a plain :visible box (a
    ;; :width widget does not collapse from the layout when hidden — a plain
    ;; wrapper does), and the submenu hugs the menu side (:halign "end") —
    ;; the menu column therefore never moves when the hovered submenu
    ;; changes width.
    (eventbox :onclick "../scripts/widgets/close_popup.py"
      (box :visible {sub_left}
        (box :class "submenu-pane" :width 375 :valign "start"
        (box :class "submenu" :valign "start" :halign "end"
             :visible {sub_show}
             :style "margin-top:${sub_top}px"
          (literal :content {sub_yuck})))))
    ;; The column width is PINNED to submenu.MENU_COL_W (290px): the two 375px
    ;; pane strips are always reserved (so the column never moves when a
    ;; picker opens), which makes the window's natural width backend-dependent
    ;; -- pinned column + fixed strips is the same number on EVERY compositor
    ;; (KDE/Wayland measures the label text narrower than Cinnamon/X11).
    (box :class "ctx-menu" :width 290 :orientation "v" :valign "start"
    ;; move.py opens the overlay + control panel and returns immediately, so it
    ;; is backgrounded (nohup ... &) to keep the shell call instant.
    (eventbox :class "ctx-btn"
              :onclick "nohup ../scripts/move/move.py --widget ${widget} --monitor ${monitor} --mode move >/dev/null 2>&1 &"
              :onhover "../scripts/widgets/submenu_hide.py"
      (box :class "ctx-btn-box" (label :text "Move")))
    (eventbox :class "ctx-btn"
              :onclick "nohup ../scripts/move/move.py --widget ${widget} --monitor ${monitor} --mode resize >/dev/null 2>&1 &"
              :onhover "../scripts/widgets/submenu_hide.py"
      (box :class "ctx-btn-box" (label :text "Resize")))
    ;; Reset writes the factory defaults to config.yaml directly (scripts/
    ;; move_ctl.py --action reset: position 0/0 + scale 1.0 for both the clock
    ;; and the panel -- for the panel the global panel.gap baseline stays
    ;; untouched) and closes the popups.
    (eventbox :class "ctx-btn"
              :onclick "../scripts/widgets/close_popup.py && ../scripts/move/move_ctl.py --widget ${widget} --monitor ${monitor} --action reset"
              :onhover "../scripts/widgets/submenu_hide.py"
      (box :class "ctx-btn-box" (label :text "Reset")))
    ;; --- group separator: actions | settings -----------------------------
    (label :class "ctx-sep" :text "───────────────────────────")
    ;; AM/PM switch (clock only): system.hour_format 24h / 12h picker.
    ;; NOTE: deliberately NOT a button — a nested GTK button owns its own
    ;; input window, which swallows the enter/leave events the eventbox
    ;; needs; a plain box+label keeps hover working.
    (box :visible {widget == "clock"}
      (eventbox :class "ctx-btn"
                :onhover "../scripts/widgets/submenu.py --item hour_format --widget ${widget}"
        (box :class "ctx-btn-box"
             (label :text {config.hour_format == "12" ? "AM/PM: 12h ▸" : "AM/PM: 24h ▸"}))))
    ;; Theme: every theme under assets/themes/appearance/, two columns.
    (eventbox :class "ctx-btn"
              :onhover "../scripts/widgets/submenu.py --item appearance --widget ${widget}"
      (box :class "ctx-btn-box"
           (label :text {"Theme: " + config.appearance_name + " ▸"})))
    (box :visible {widget == "clock"}
      (label :class "ctx-sep" :text "───────────────────────────"))
    ;; Units (clock only): metric <-> imperial; picking one also refreshes
    ;; weather_info instantly so °C/°F does not wait for the 10-minute defpoll.
    (box :visible {widget == "clock"}
      (eventbox :class "ctx-btn"
                :onhover "../scripts/widgets/submenu.py --item units --widget ${widget}"
        (box :class "ctx-btn-box"
             (label :text {config.units == "imperial" ? "Units: °F ▸" : "Units: °C ▸"}))))
    ;; Weather settings (clock only): city / language_code / lang / units /
    ;; api_url / api_key (the draggable GTK form opens CENTERED ON this
    ;; monitor - like the About dialog). Editing is draft-only; the Save
    ;; button validates and writes the changed values in one go
    ;; (config.local.yaml via config_set.py + the .api_key file) and refreshes
    ;; weather_info instantly (no 10-minute defpoll wait); the Reset button
    ;; drops the local weather overrides so the config.yaml/theme defaults win
    ;; again; both are backgrounded (nohup ... &) so the click returns
    ;; instantly.
    (box :visible {widget == "clock"}
      (eventbox :class "ctx-btn"
                :onclick "nohup ../scripts/move/weather_ctl.py --widget ${widget} --monitor ${monitor} >/dev/null 2>&1 &"
                :onhover "../scripts/widgets/submenu_hide.py"
        (box :class "ctx-btn-box" (label :text "Weather"))))
    (box :visible {widget == "panel"}
      (label :class "ctx-sep" :text "───────────────────────────"))
    ;; Panel visibility (panel only): panel.enabled shown / hidden.
    (box :visible {widget == "panel"}
      (eventbox :class "ctx-btn"
                :onhover "../scripts/widgets/submenu.py --item panel_enabled --widget ${widget}"
        (box :class "ctx-btn-box"
             (label :text {config.panel_enabled == "true" ? "Panel: shown ▸" : "Panel: hidden ▸"}))))
    ;; Panel side (panel only): panel.window.alignment right / left.
    (box :visible {widget == "panel"}
      (eventbox :class "ctx-btn"
                :onhover "../scripts/widgets/submenu.py --item panel_alignment --widget ${widget}"
        (box :class "ctx-btn-box"
             (label :text {config.panel_alignment == "left" ? "Side: left ▸" : "Side: right ▸"}))))
    ;; Panel gap (panel only): top/right/bottom/left spacing between the panel
    ;; and the screen/taskbar edges (panel.gap). gap_ctl.py opens the draggable
    ;; GTK control panel NEXT TO THE PANEL WIDGET (10px, on the side with more
    ;; free space - like move.py opens the Move/Resize panel); +/- and typing
    ;; only change the draft values there, the Save button commits them all
    ;; in one go; it is backgrounded (nohup ... &) so the click returns
    ;; instantly.
    (box :visible {widget == "panel"}
      (eventbox :class "ctx-btn"
                :onclick "nohup ../scripts/move/gap_ctl.py --widget ${widget} --monitor ${monitor} >/dev/null 2>&1 &"
                :onhover "../scripts/widgets/submenu_hide.py"
        (box :class "ctx-btn-box" (label :text "Panel gap"))))
    ;; --- group separator: settings | system -------------------------------
    (label :class "ctx-sep" :text "───────────────────────────")
    ;; Hard reset: deletes git-ignored config.local.yaml (no backup) and
    ;; relayouts, restoring every committed default (scripts/bin/hard-reset.sh).
    (eventbox :class "ctx-btn"
              :onclick "../scripts/widgets/close_popup.py && nohup ../scripts/bin/hard-reset.sh >/dev/null 2>&1 &"
              :onhover "../scripts/widgets/submenu_hide.py"
      (box :class "ctx-btn-box" (label :text "Hard reset")))
    (eventbox :class "ctx-btn"
              :onclick "../scripts/widgets/about.py --open --monitor ${monitor}"
              :onhover "../scripts/widgets/submenu_hide.py"
      (box :class "ctx-btn-box" (label :text "About"))))
    ;; RIGHT picker pane — the default layout (hidden when the flipped
    ;; sub_left=true layout shows the pane on the left instead). submenu.py
    ;; fills sub_yuck / sub_top and shows it while a selectable row is
    ;; hovered. The pane strip is a FIXED 375px (wrapped in a plain
    ;; :visible box, see the left pane) and the submenu hugs the menu side
    ;; (:halign "start"), so the menu column never moves when the hovered
    ;; submenu changes width. Clicking the empty pane area dismisses
    ;; everything, like the rest of the popup surface.
    (eventbox :onclick "../scripts/widgets/close_popup.py"
      (box :visible {sub_right}
        (box :class "submenu-pane" :width 375 :valign "start"
        (box :class "submenu" :valign "start" :halign "start"
             :visible {sub_show}
             :style "margin-top:${sub_top}px"
          (literal :content {sub_yuck})))))))

;; ===========================================================================
;; Hover submenu (value picker for the selectable context-menu rows)
;; ===========================================================================

;; One generic window reused by all five items: submenu.py pushes the option
;; picker definition (prebuilt by submenu.py as a static yuck literal) and
;; the geometry via --arg at hover time. Clicking an entry writes it through
;; menu_toggle.py; ESC / outside clicks close everything via close_popup.py.
(defwindow main_window
  [main_win_x main_win_y main_win_w main_win_h main_w main_h
   main_scale_perc_x main_scale_perc_y main_translate_x main_translate_y screen]
  :monitor {screen}
  :geometry (geometry :x {main_win_x}
                      :y {main_win_y}
                      :width {main_win_w}
                      :height {main_win_h}
                      :anchor "top left")
  :stacking "bottom"
  :windowtype "normal"
  :wm-ignore true
  (widget_clock_weather :main_w main_w :main_h main_h
                        :main_scale_perc_x main_scale_perc_x
                        :main_scale_perc_y main_scale_perc_y
                        :main_translate_x main_translate_x
                        :main_translate_y main_translate_y
                        :screen screen))

;; panel_window is parametrized so start.sh can open one instance per monitor
;; with `eww open --id panel_<N> --screen <N> --arg "screen=<N>" ... panel_window`.
;; `screen` is both the monitor selector and the :monitor value; ph (the
;; NATURAL height) feeds the chart selector (panel.files[ph]); pwin_x/y/w/h
;; is the CANVAS geometry computed by scripts/move/widget_rect.py (same rule
;; as for the clock: max(natural, visible) per axis, positioned so it always
;; fits the monitor, "top left" anchor with frame coords on both
;; compositors); the translates (desired device px offset divided by the
;; axis scale — see widget_clock_weather) place the scaled content exactly on
;; the visible rectangle.
(defwindow panel_window
  [screen pw ph pwin_x pwin_y pwin_w pwin_h panel_scale_perc_x panel_scale_perc_y panel_translate_x panel_translate_y]
  :monitor {screen}
  :geometry (geometry :x {pwin_x}
                      :y {pwin_y}
                      :width {pwin_w}
                      :height {pwin_h}
                      :anchor "top left")
  :stacking "bottom"
  :windowtype "normal"
  :wm-ignore true
  (widget_panel :ph ph
                :panel_scale_perc_x panel_scale_perc_x
                :panel_scale_perc_y panel_scale_perc_y
                :panel_translate_x panel_translate_x :panel_translate_y panel_translate_y
                :screen screen))

;; X11 variants: eww 0.5.0 only honours `:stacking "foreground"`/`"background"` on
;; X11 ("bottom" is a no-op there), so these windows use "background"
;; (gtk set_keep_below -> _NET_WM_STATE_BELOW). With `:wm-ignore false` the
;; windows are WM-managed Toplevels, so Cinnamon/Muffin keeps them below opened
;; windows (the same way Conky's "below" hint works) while the wallpaper stays
;; below them. Eww always disables decorations and the taskbar entry
;; (set_decorated/set_skip_taskbar_hint). scripts/bin/start.sh picks these
;; definitions when the compositor is x11; the Wayland ones above use "bottom"
;; (Layer::Bottom).
(defwindow main_window_x11
  [main_win_x main_win_y main_win_w main_win_h main_w main_h
   main_scale_perc_x main_scale_perc_y main_translate_x main_translate_y screen]
  :monitor {screen}
  :geometry (geometry :x {main_win_x}
                      :y {main_win_y}
                      :width {main_win_w}
                      :height {main_win_h}
                      :anchor "top left")
  :stacking "background"
  :windowtype "utility"
  :wm-ignore false
  (widget_clock_weather :main_w main_w :main_h main_h
                        :main_scale_perc_x main_scale_perc_x
                        :main_scale_perc_y main_scale_perc_y
                        :main_translate_x main_translate_x
                        :main_translate_y main_translate_y
                        :screen screen))

(defwindow panel_window_x11
  [screen pw ph pwin_x pwin_y pwin_w pwin_h panel_scale_perc_x panel_scale_perc_y panel_translate_x panel_translate_y]
  :monitor {screen}
  :geometry (geometry :x {pwin_x}
                      :y {pwin_y}
                      :width {pwin_w}
                      :height {pwin_h}
                      :anchor "top left")
  :stacking "background"
  :windowtype "utility"
  :wm-ignore false
  (widget_panel :ph ph
                :panel_scale_perc_x panel_scale_perc_x
                :panel_scale_perc_y panel_scale_perc_y
                :panel_translate_x panel_translate_x :panel_translate_y panel_translate_y
                :screen screen))

;; ===========================================================================
;; Context menu window
;; ===========================================================================

;; On X11 `:stacking "overlay"` keeps the window a normal toplevel (no
;; set_keep_above/below), so it floats above the keep-below widget windows.
;; :focusable true lets the buttons receive clicks on Wayland.
;; The height is DYNAMIC (menu_h, default "550px" from ctx.py): the hover
;; submenu pane renders inside this window, and long pickers (the theme
;; list) grow it via submenu.py so nothing gets clipped; the pane top and
;; the window y are edge-clamped there as well.
;; The WIDTH is a fixed 1040px = left pane strip (375) + pinned menu column
;; (290 = submenu.MENU_COL_W, see :width on widget_ctx_menu) + right pane
;; strip (375). Both strips are reserved even when no picker is open (the
;; picker renders inside one of them, and the empty rest is a
;; click-to-dismiss zone). Pinning width + column makes the menu map at the
;; SAME size on every compositor -- an entirely natural-sized window gets its
;; width from the label text, which GTK measures differently under
;; KDE/Wayland (narrower) and Cinnamon/X11 (wider). Keep 290 in sync with
;; submenu.MENU_COL_W and both 375s with submenu.PANE_W.
(defwindow ctx_menu
  [screen widget monitor pos_x pos_y menu_h]
  :monitor {screen}
  :geometry (geometry :x {pos_x}
                      :y {pos_y}
                      :width "1040px"
                      :height {menu_h}
                      :anchor "top left")
  :stacking "overlay"
  :windowtype "normal"
  :wm-ignore true
  :focusable true
  (widget_ctx_menu :widget widget :monitor monitor))

;; ===========================================================================
;; Dismiss overlay: transparent, full-monitor layer opened UNDER the context
;; menu / the GTK About window. Clicking anywhere outside them hits this
;; surface and closes the popups (eww 0.5.0 has no built-in
;; click-outside-to-close). It is opened before the popup so the popup stacks
;; above it; the popup scripts close it again (scripts/widgets/ctx.py, about.py --open,
;; move.py, close_popup.py).
;; ===========================================================================

(defwindow dismiss_overlay
  [screen]
  :monitor {screen}
  :geometry (geometry :width "100%" :height "100%")
  :stacking "overlay"
  :windowtype "normal"
  :wm-ignore true
  :focusable true
  (eventbox :timeout "10s" :onclick "../scripts/widgets/close_popup.py"
    (box :class "move-overlay")))

;; ===========================================================================
;; Hover submenu: value picker for the selectable context-menu rows (AM/PM,
;; Theme, Units, Panel, Side). Opened by scripts/widgets/submenu.py next to the
;; hovered row; geometry and contents arrive via --arg / eww update at hover
;; time. Not focusable: it is pointer-driven only, the keyboard daemon keeps
;; handling ESC for the whole popup stack.
;; ===========================================================================
