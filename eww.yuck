;; ===========================================================================
;; Clock-With-Weather-EWW
;;
;; Two windows:
;;   1. main_window  -> Clock + Weather widget (745x250, centered)
;;   2. panel_window -> System monitor panel (CPU / MEMORY / NET DOWN / NET UP)
;; ===========================================================================

;; --- Clock data ------------------------------------------------------------
(defpoll hour :interval "1s"
  `date +$(./scripts/config.py --key hour_format | sed 's/24/%H/; s/12/%I/')`)

(defpoll minutes :interval "1s" `date +:%M`)

(defpoll seconds :interval "1s" `date +%S`)

(defpoll date_year :interval "1m"
  `date +%Y.`)

(defpoll date_day :interval "1m"
  `LC_TIME=en_US.UTF-8 date "+| %B %d. | %A"`)

;; --- System info (HDD / CPU / RAM / SWAP) -----------------------------------
(defpoll system_info :interval "5s"
  `./scripts/system.py`)

;; --- Weather ----------------------------------------------------------------
(defpoll weather_info :interval "10m"
  `./scripts/weather.py $(./scripts/config.py --key api_key) $(./scripts/config.py --key city) $(./scripts/config.py --key lang) $(./scripts/config.py --key units)`)

;; --- System monitor panel (CPU / MEMORY / NET UP / NET DOWN charts) ---------
(defpoll panel :interval "1s"
  `./scripts/panel.py`)

;; --- Configuration / theme --------------------------------------------------
;; The inotify watcher (scripts/watch.py) already reloads the widget on YAML
;; changes; these short intervals are a safety net for external edits.
(defpoll config :interval "5s" `./scripts/config.py`)

(defpoll theme :interval "5s" `cat eww.theme.json`)

;; ===========================================================================
;; Image path helpers
;; ===========================================================================

(defwidget widget_clock_weather []
  (box :class "main-container" :orientation "h" :space-evenly false

    ;; ------------------------------------------------------------------
    ;; ABSOLUTE layout (745x250). Baseline coordinates converted to the
    ;; label top: CSS margin-top = baseline_y - 0.73*font_size (cap height);
    ;; images anchored to the top-left corner (pos - size/2).
    ;; ------------------------------------------------------------------
    (overlay :class "widget-overlay"
      (box :class "section-sizer" :width 745 :height 250)

      ;; Background hugging the content with an inner gap (térköz); the
      ;; window canvas (745x250) stays transparent around it.
      (box :class "widget-bg" :halign "start" :valign "start")

      ;; Date / year --- text(20,45) / text(70,45), font 20
      (label :class "year-label" :text date_year
             :halign "start" :valign "start")
      (label :class "date-label" :text date_day
             :halign "start" :valign "start")

      ;; Hour / minutes / seconds --- text(10/170/366,122)
      (label :class "hour-label" :text hour
             :halign "start" :valign "start")
      (label :class "minutes-label" :text minutes
             :halign "start" :valign "start")
      (label :class "seconds-label" :text {": " + seconds}
             :halign "start" :valign "start")

      ;; System info row 1 (HDD, RAM) --- baseline y=180, font 15
      (label :class "sys-label hdd-label" :text "HDD"
             :halign "start" :valign "start")
      (label :class "sys-value hdd-value" :text {system_info.hdd}
             :halign "start" :valign "start")
      (label :class "sys-label ram-label" :text "RAM"
             :halign "start" :valign "start")
      (label :class "sys-value ram-value" :text {system_info.ram}
             :halign "start" :valign "start")

      ;; System info row 2 (CPU, SWAP) --- baseline y=200, font 15
      (label :class "sys-label cpu-label" :text "CPU"
             :halign "start" :valign "start")
      (label :class "sys-value cpu-value" :text {system_info.cpu}
             :halign "start" :valign "start")
      (label :class "sys-label swap-label" :text "SWAP"
             :halign "start" :valign "start")
      (label :class "sys-value swap-value" :text {system_info.swap}
             :halign "start" :valign "start")

      ;; Vertical divider line --- image centered (415,110), 1x205
      (image :class "divider"
             :path { "generated/icons/" + theme.theme + "/elements/line.png" }
             :image-width 2 :image-height 186
             :halign "start" :valign "start")

      ;; Weather icon --- image centered (470,57), 64x64
      (image :class "weather-icon"
             :path { "generated/icons/" + theme.theme + "/weather/" + theme.icon_set + "/" + weather_info.icon_path + ".png" }
             :image-width 64 :image-height 64
             :halign "start" :valign "start")

      ;; City --- icon centered (440,112) 20x20; text(465,112) font 30
      (image :class "city-icon"
             :path { "generated/icons/" + theme.theme + "/elements/map-marker-gray.png" }
             :image-width 20 :image-height 20
             :halign "start" :valign "start")
      (label :class "city-label" :text {config.city}
             :halign "start" :valign "start")

      ;; Temperature --- thermometer icon beside celsius, same row as CPU/SWAP
      (image :class "temp-icon"
             :path { "generated/icons/" + theme.theme + "/elements/temperature-gray.png" }
             :image-width 32 :image-height 32
             :halign "start" :valign "start")
      (label :class "temp-label" :text {weather_info.temp_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start")

      ;; Description --- icon centered (435,175) 10x10; text(445,180) font 15
      (image :class "details-icon"
             :path { "generated/icons/" + theme.theme + "/elements/arrow-right.png" }
             :image-width 10 :image-height 10
             :halign "start" :valign "start")
      (label :class "details-label" :text {weather_info.weather[0].description}
             :halign "start" :valign "start")

      ;; MIN --- icon centered (435,195) 10x10; text(445,200) font 15
      (image :class "stat-icon stat-min-icon"
             :path { "generated/icons/" + theme.theme + "/elements/arrow-down.png" }
             :image-width 10 :image-height 10
             :halign "start" :valign "start")
      (label :class "stat-label stat-min-label" :text {weather_info.temp_min_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start")

      ;; MAX --- icon centered (495,195) 10x10; text(505,200) font 15
      (image :class "stat-icon stat-max-icon"
             :path { "generated/icons/" + theme.theme + "/elements/arrow-up.png" }
             :image-width 10 :image-height 10
             :halign "start" :valign "start")
      (label :class "stat-label stat-max-label" :text {weather_info.temp_max_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start")

      ;; FEELS LIKE --- icon centered (555,195) 4x10; text(565,200) font 15
      (image :class "stat-icon stat-feels-icon"
             :path { "generated/icons/" + theme.theme + "/elements/white-man.png" }
             :image-width 4 :image-height 10
             :halign "start" :valign "start")
      (label :class "stat-label stat-feels-label" :text {weather_info.feels_like_fmt + weather_info.unit_symbol}
             :halign "start" :valign "start"))))


;; ===========================================================================
;; System monitor panel
;; ===========================================================================

(defwidget widget_panel [ph]
  (box :class "panel-container" :orientation "v" :space-evenly true

    (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
      (label :class "panel-title" :text "CPU" :halign "start")
      (label :class "panel-status" :text {panel.cpu_txt} :halign "start")
      (image :class "panel-chart" :path {panel.files[ph].cpu} :halign "start"))

    (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
      (label :class "panel-title" :text "MEMORY" :halign "start")
      (label :class "panel-status" :text {panel.mem_txt} :halign "start")
      (image :class "panel-chart" :path {panel.files[ph].mem} :halign "start"))

    (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
      (label :class "panel-title" :text "NET DOWN" :halign "start")
      (label :class "panel-status" :text {panel.down_txt} :halign "start")
      (image :class "panel-chart" :path {panel.files[ph].down} :halign "start"))

    (box :class "panel-section" :orientation "v" :space-evenly false :halign "start"
      (label :class "panel-title" :text "NET UP" :halign "start")
      (label :class "panel-status" :text {panel.up_txt} :halign "start")
      (image :class "panel-chart" :path {panel.files[ph].up} :halign "start"))))

;; ===========================================================================
;; Windows
;; ===========================================================================

;; main_window is parametrized like panel_window so scripts/start.sh can pass
;; the clock widget's alignment (-> anchor) and pixel offsets from config.yaml
;; (window.alignment / window.position_x / window.position_y).
(defwindow main_window
  [main_anchor main_x main_y]
  :monitor 0
  :geometry (geometry :x {main_x}
                      :y {main_y}
                      :width "745px"
                      :height "250px"
                      :anchor {main_anchor})
  :stacking "bottom"
  :windowtype "normal"
  :wm-ignore true
  (widget_clock_weather))

;; panel_window is parametrized so start.sh can open one instance per monitor
;; with `eww open --id panel_<N> --screen <N> --arg "screen=<N>" ... panel_window`.
;; `screen` is both the monitor selector and the :monitor value; the rest are
;; the panel geometry (px/py/pw/ph) and its anchor, computed per monitor by
;; scripts/workarea.py --per-monitor.
(defwindow panel_window
  [screen px py pw ph panchor]
  :monitor {screen}
  :geometry (geometry :x {px}
                      :y {py}
                      :width {pw}
                      :height {ph}
                      :anchor {panchor})
  :stacking "bottom"
  :windowtype "normal"
  :wm-ignore true
  (widget_panel :ph ph))

;; X11 variants: eww 0.5.0 only honours `:stacking "foreground"`/`"background"` on
;; X11 ("bottom" is a no-op there), so these windows use "background"
;; (gtk set_keep_below -> _NET_WM_STATE_BELOW). With `:wm-ignore false` the
;; windows are WM-managed Toplevels, so Cinnamon/Muffin keeps them below opened
;; windows (the same way Conky's "below" hint works) while the wallpaper stays
;; below them. Eww always disables decorations and the taskbar entry
;; (set_decorated/set_skip_taskbar_hint). scripts/start.sh picks these
;; definitions when the compositor is x11; the Wayland ones above use "bottom"
;; (Layer::Bottom).
(defwindow main_window_x11
  [main_anchor main_x main_y]
  :monitor 0
  :geometry (geometry :x {main_x}
                      :y {main_y}
                      :width "745px"
                      :height "250px"
                      :anchor {main_anchor})
  :stacking "background"
  :windowtype "utility"
  :wm-ignore false
  (widget_clock_weather))

(defwindow panel_window_x11
  [screen px py pw ph panchor]
  :monitor {screen}
  :geometry (geometry :x {px}
                      :y {py}
                      :width {pw}
                      :height {ph}
                      :anchor {panchor})
  :stacking "background"
  :windowtype "utility"
  :wm-ignore false
  (widget_panel :ph ph))
